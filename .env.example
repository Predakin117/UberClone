# Copia este archivo como .env y coloca los valores reales (el .env nunca se sube a git).

# Solo se usa en app.config.js (build nativo de Android); no llega al bundle JS
GOOGLE_MAPS_API_KEY=

# Variables con prefijo EXPO_PUBLIC_ quedan disponibles en la app vía src/config/env.js
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_BACKEND_API_URL=
