# Plantilla de variables de entorno. Copia este archivo a `.env` y pon tus valores.
# `.env` NUNCA se sube a Git (está en .gitignore). Aquí solo hay valores FALSOS.

# --- Supabase Storage (reemplaza a Vercel Blob; solo servidor) ---
# Project Settings → Data API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co
# Project Settings → API Keys → Secret key (sb_secret_…). Da acceso total: JAMÁS con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_valor_falso
# Nombre del bucket PRIVADO que creaste en Storage
SUPABASE_BUCKET=facturas

# --- Firebase, configuración de la app web (pública por diseño) ---
NEXT_PUBLIC_FIREBASE_API_KEY=valor-falso
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# --- Firebase Admin, cuenta de servicio (SOLO servidor, secreto) ---
# Del JSON de la cuenta de servicio: project_id, client_email y private_key.
FIREBASE_ADMIN_PROJECT_ID=tu-proyecto
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Entre comillas dobles y con los saltos de línea escritos como \n literales.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nVALOR_FALSO\n-----END PRIVATE KEY-----\n"

# --- Autorización (Fase A): correos que pueden usar la app, separados por comas ---
USUARIOS_PERMITIDOS=tu-correo@ejemplo.com
