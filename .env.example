# Copia este archivo como .env y coloca los valores reales (el .env nunca se sube a git).

# Solo se usa en app.config.js (build nativo de Android); no llega al bundle JS
GOOGLE_MAPS_API_KEY=

# Variables con prefijo EXPO_PUBLIC_ quedan disponibles en la app vía src/config/env.js.
# No son secretas: la configuración web de Firebase la protegen las reglas de
# Firestore (firestore.rules). Nunca pongas aquí llaves secretas.

# Firebase: Configuración del proyecto → Tus apps → app web (bloque firebaseConfig)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary: Cloud name del panel y nombre de un upload preset sin firma (Unsigned).
# El API Secret de Cloudinary NO va aquí.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

EXPO_PUBLIC_BACKEND_API_URL=
