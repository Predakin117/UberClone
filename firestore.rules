// AI-assisted: see docs/AI_LOG.md #10
// Reglas de Firestore. Se copian en la consola: Firestore Database → Reglas → Publicar.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada conductor (sesión anónima de Firebase Auth) solo ve y escribe su documento
    match /drivers/{driverId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == driverId;
      }

      function statusOf(data) {
        return data.get('status', null);
      }

      allow read: if isOwner();

      // Al crear el documento solo puede quedar sin estado (borrador) o "pending"
      allow create: if isOwner()
        && statusOf(request.resource.data) in [null, 'pending'];

      // El estado no lo cambia el conductor, salvo de borrador a "pending" al enviar.
      // "approved" solo se pone desde la consola de Firebase, como pide el enunciado.
      allow update: if isOwner()
        && (statusOf(request.resource.data) == statusOf(resource.data)
          || (statusOf(resource.data) == null
            && statusOf(request.resource.data) == 'pending'));

      allow delete: if false;
    }

    // AI-assisted: see docs/AI_LOG.md #53
    // Login lookup: one document per email or phone (id "email_..." or "phone_...")
    // pointing to the account. Anyone can check one exact key before logging in,
    // but nobody can list the collection, so the drivers' data is never exposed.
    // A key can only be created once, so an email or phone can't be taken twice.
    match /loginIndex/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Email and phone of each account (Firebase Auth with email and password)
    match /accounts/{uid} {
      allow read, create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }
  }
}
