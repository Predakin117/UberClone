# ---------- Dependencies ----------
node_modules/
backend/node_modules/

# ---------- Secrets (NEVER commit) ----------
# Real values live only in .env files; the *.example templates ARE committed.
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# Firebase / Google credentials
*-firebase-adminsdk-*.json
serviceAccountKey.json
google-services.json
GoogleService-Info.plist

# Signing keys and certificates
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# ---------- Expo / React Native ----------
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native folders (generated by `expo prebuild`)
android/
ios/

# Metro
.metro-health-check*

# ---------- Testing ----------
coverage/

# ---------- Logs ----------
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json