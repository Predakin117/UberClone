# Copia este archivo como backend/.env con los valores reales (el .env nunca se sube a git).

# Puerto del backend. La app lo usa en EXPO_PUBLIC_BACKEND_API_URL del .env de la raíz.
PORT=3000

# Gmail que envía los códigos y su contraseña de aplicación (16 letras, sin espacios).
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
MAIL_USER=
MAIL_PASS=

# Minutos que dura cada código
CODE_TTL_MINUTES=10

# OpenRouteService: rutas, distancia y duración de los viajes (backend/src/rutas.js).
# Llave gratuita en https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
