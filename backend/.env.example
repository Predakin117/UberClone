# Copia este archivo como backend/.env con los valores reales (el .env nunca se sube a git).

# Puerto del backend. La app lo usa en EXPO_PUBLIC_BACKEND_API_URL del .env de la raíz.
PORT=3000

# Gmail que envía los códigos y su contraseña de aplicación (16 letras, sin espacios).
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
MAIL_USER=
MAIL_PASS=

# Minutos que dura cada código
CODE_TTL_MINUTES=10

# OpenRouteService: rutas, distancia y duración de los viajes (backend/src/rutas.js).
# Llave gratuita en https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Mercado Pago Checkout Pro (backend/src/mercadoPago.js). Solo credenciales de PRUEBA:
# el Access Token de la cuenta de prueba del vendedor (empieza por APP_USR), en
# Tus integraciones → tu aplicación → Credenciales de prueba.
MP_ACCESS_TOKEN=

# Dirección https pública de este backend (el túnel de Cloudflare), sin /api/v1.
# Mercado Pago la usa para el webhook y la página de regreso. Cambia cada vez que
# se abre el túnel. Es opcional: sin ella, la app revisa el pago al cerrar el checkout.
PUBLIC_BACKEND_URL=

# Pago dividido (reto de bonificación de la sección 4): cada conductor vincula su
# cuenta de Mercado Pago y Mercado Pago reparte el pago. Son el Client ID y el
# Client Secret de la aplicación de la plataforma (Tus integraciones → tu aplicación
# → Credenciales). Además necesita PUBLIC_BACKEND_URL, y en la aplicación hay que
# registrar la URL de redireccionamiento <PUBLIC_BACKEND_URL>/api/v1/pagos/mercadopago/oauth.
# Sin ellas, la plataforma cobra el viaje completo, como antes.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
