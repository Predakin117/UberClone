{
  "name": "uberclone-driver-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend del código de verificación por correo de UberClone Conductor",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test",
    "simular": "node --env-file=.env scripts/simular-solicitud.js",
    "simular-historial": "node scripts/simular-historial.js",
    "limpiar-simulados": "node scripts/limpiar-simulados.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "nodemailer": "^7.0.0"
  }
}
